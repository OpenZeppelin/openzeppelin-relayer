# Base image
# Rustc v1.91.1
# The digest needs to be updated everytime the minimum version is changed, and if the version is above 1.91.1
FROM cgr.dev/chainguard/rust:latest-dev@sha256:33faad9a26e8437ed9725bea3eb2d1e85facd1c035a31af8d485ea8c0a935532 AS base

USER root
RUN apk update && apk --no-cache add \
    openssl-dev \
    perl \
    libsodium-dev

WORKDIR /usr/app

# Optional: set to "redis-tls-native" or "redis-tls-rustls" to enable Redis TLS support
ARG CARGO_FEATURES=""

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/usr/app/target \
    if [ -n "$CARGO_FEATURES" ]; then \
      cargo install --root /usr/app --path . --locked --features "$CARGO_FEATURES"; \
    else \
      cargo install --root /usr/app --path . --locked; \
    fi

# Build generated JavaScript natively so esbuild does not run through QEMU.
FROM --platform=$BUILDPLATFORM cgr.dev/chainguard/wolfi-base AS plugin-builder

ARG NODE_VERSION=20.19
USER root
RUN apk add --no-cache nodejs=~${NODE_VERSION} npm
RUN npm install -g pnpm

COPY ./plugins /app/plugins
WORKDIR /app/plugins
RUN pnpm install --frozen-lockfile

# Install native runtime dependencies for the target image architecture.
FROM cgr.dev/chainguard/wolfi-base AS plugin-runtime

ARG NODE_VERSION=20.19
USER root
RUN apk add --no-cache nodejs=~${NODE_VERSION} npm
RUN npm install -g pnpm

COPY --chown=nonroot:nonroot ./plugins /app/plugins
USER nonroot
WORKDIR /app/plugins
RUN pnpm install --prod --frozen-lockfile --ignore-scripts
COPY --from=plugin-builder --chown=nonroot:nonroot \
    /app/plugins/lib/pool-executor.js \
    /app/plugins/lib/pool-executor.js.sha256 \
    /app/plugins/lib/

# Setting up build directories
FROM cgr.dev/chainguard/wolfi-base

WORKDIR /app
COPY --from=base --chown=nonroot:nonroot /usr/app/bin/openzeppelin-relayer /app/openzeppelin-relayer
COPY --from=base /usr/lib/libssl.so.3 /usr/lib/libssl.so.3
COPY --from=base /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so.3

ARG NODE_VERSION=20.19
USER root
RUN apk add --no-cache nodejs=~${NODE_VERSION}
ENV PATH="/usr/local/bin:$PATH"

COPY --from=plugin-runtime --chown=nonroot:nonroot /app/plugins /app/plugins

USER nonroot
WORKDIR /app
ENV PATH="/app/plugins/node_modules/.bin:/usr/local/bin:$PATH"

ENV APP_PORT=8080
ENV METRICS_PORT=8081

EXPOSE ${APP_PORT}/tcp ${METRICS_PORT}/tcp

# starting up
ENTRYPOINT ["/app/openzeppelin-relayer"]
