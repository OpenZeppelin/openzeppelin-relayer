# Floor for the system trust store. 20260909-r3 distrusts the compromised
# eMudhra intermediates (https://emudhra.we-have-a-problem.com). apk fails the
# build if it cannot satisfy the floor, and changing it invalidates cached layers.
ARG MIN_CA_CERTIFICATES_BUNDLE_VERSION=20260909-r3
# Node.js 24.22.1 is the first 24.x that rejects the compromised eMudhra intermediates.
ARG MIN_NODEJS_VERSION=24.22.1

# Base image
# Rustc v1.93.0 minimum (MSRV, see rust-version in Cargo.toml)
# The digest needs to be updated everytime the minimum version is changed, and if the version is above 1.93.0
FROM cgr.dev/chainguard/rust:latest-dev@sha256:4325195ba82741fbfdb5cdffc6792c5948bdfa97cb4c95f65cfcf172a59de201 AS base

USER root
RUN apk update && apk --no-cache add \
    openssl-dev \
    perl \
    libsodium-dev

WORKDIR /usr/app

# Optional: set to "redis-tls-native" or "redis-tls-rustls" to enable Redis TLS support
ARG CARGO_FEATURES=""

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/usr/app/target \
    if [ -n "$CARGO_FEATURES" ]; then \
      cargo install --root /usr/app --path . --locked --features "$CARGO_FEATURES"; \
    else \
      cargo install --root /usr/app --path . --locked; \
    fi

# Setting up build directories
FROM cgr.dev/chainguard/wolfi-base@sha256:88a20e2d017bd20cdc0cb3910de603e7bea9512a6c351a8dd3c9df212ab03d73

WORKDIR /app
COPY --from=base --chown=nonroot:nonroot /usr/app/bin/openzeppelin-relayer /app/openzeppelin-relayer
COPY --from=base /usr/lib/libssl.so.3 /usr/lib/libssl.so.3
COPY --from=base /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so.3

ARG MIN_NODEJS_VERSION
ARG MIN_CA_CERTIFICATES_BUNDLE_VERSION
USER root
RUN apk add --no-cache "ca-certificates-bundle>=${MIN_CA_CERTIFICATES_BUNDLE_VERSION}" "nodejs-24>=${MIN_NODEJS_VERSION}" npm
ENV PATH="/usr/local/bin:$PATH"

# Pin the pnpm major: pnpm 12 ships a preinstall script that newer npm blocks by
# default, which leaves a broken pnpm shim. pnpm 10 matches the lockfile format.
RUN npm install -g pnpm@10

# Copy plugins folder and install dependencies
COPY --chown=nonroot:nonroot ./plugins /app/plugins

USER nonroot
WORKDIR /app/plugins
# Full install so postinstall can compile pool-executor.js with the
# lockfile's ts-node/typescript. prune --prod then drops the dev
# tree; --ignore-scripts is required because prune re-runs
# postinstall after ts-node is already gone.
RUN pnpm install --frozen-lockfile \
 && pnpm prune --prod --ignore-scripts

# Return to app root
WORKDIR /app
ENV PATH="/app/plugins/node_modules/.bin:/usr/local/bin:$PATH"

ENV APP_PORT=8080
ENV METRICS_PORT=8081

EXPOSE ${APP_PORT}/tcp ${METRICS_PORT}/tcp

# starting up
ENTRYPOINT ["/app/openzeppelin-relayer"]
